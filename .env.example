# Copy this file to .env and fill in real values:
#   cp .env.example .env
# (.env is git-ignored and never committed.)

# Cloudflare Tunnel token for private remote access (optional).
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels.
APPS_TUNNEL_TOKEN=change-me

# Master key clients use to authenticate against the LiteLLM proxy.
# Generate one with: openssl rand -hex 32
LITELLM_MASTER_KEY=change-me

# OpenRouter API key that powers the free-tier cloud fallback models.
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=change-me

# App Portal Settings
# Show media apps on the apps portal: true / false
SHOW_MEDIA_APPS=true
