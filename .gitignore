# homelab-ai-stack — keep this public repo curated and secrets-free.
# Everything matched here is intentionally excluded from the repository.

# Local environment file with real secrets (see .env.example instead)
.env
.env.*
!.env.example

# SearXNG real config: contains a generated secret_key.
# Only the placeholder example file is committed.
searxng/settings.yml

# Private nested profile-site repository — never part of this repo
profile/

# Portal: the page, fonts and nginx template are tracked. Excluded: the
# ta-plus modpack (generated elsewhere; large binaries and third-party jars),
# local page backups, and an unused legacy nginx config.
portal/public/ta-plus/
portal/backup-*/
portal/nginx.conf

# Runtime data directories (not published)
open-webui/
ollama/

# Logs
litellm/*.log
*.log

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Python test / coverage outputs
.pytest_cache/
.coverage
.coverage.*
coverage-summary.json

# OS / editor junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
*~
*.swp
*.swo
